diff --git a/video/out/gpu/hwdec.h b/video/out/gpu/hwdec.h
index ae827fc7..88fd0774 100644
--- a/video/out/gpu/hwdec.h
+++ b/video/out/gpu/hwdec.h
@@ -91,6 +91,10 @@ struct ra_hwdec_mapper {
     // The common code won't mess with these, so you can e.g. set them in the
     // .init() callback.
     struct ra_tex *tex[4];
+
+    // GPU work submitted by the mapper outside the renderer command stream.
+    uint64_t external_gpu_time_ns;
+    uint64_t external_gpu_time_serial;
 };
 
 // This can be used to map frames of a specific hw format as GL textures.
diff --git a/video/out/vo_gpu_next.c b/video/out/vo_gpu_next.c
index cd40793b..1a61cf78 100644
--- a/video/out/vo_gpu_next.c
+++ b/video/out/vo_gpu_next.c
@@ -114,6 +114,7 @@ struct priv {
     struct ra_hwdec_mapper *hwdec_mapper;
     struct timer_pool *hwdec_timer;
     struct mp_pass_perf hwdec_perf;
+    uint64_t hwdec_external_time_serial;
     struct ra_hwdec_mapper *el_hwdec_mapper;
     struct timer_pool *el_hwdec_timer;
     struct timer_pool *sw_upload_timer;
@@ -760,6 +761,19 @@ static bool hwdec_acquire(pl_gpu gpu, struct pl_frame *frame)
     if (measuring) {
         timer_pool_stop(p->hwdec_timer);
         p->hwdec_perf = timer_pool_measure(p->hwdec_timer);
+        if (p->hwdec_mapper->external_gpu_time_serial !=
+            p->hwdec_external_time_serial) {
+            p->hwdec_external_time_serial =
+                p->hwdec_mapper->external_gpu_time_serial;
+            uint64_t elapsed = p->hwdec_mapper->external_gpu_time_ns;
+            p->hwdec_perf = (struct mp_pass_perf){
+                .last = elapsed,
+                .avg = elapsed,
+                .peak = elapsed,
+                .samples = {elapsed},
+                .count = 1,
+            };
+        }
         stats_time_end(p->stats, "hwdec-map");
     }
 
