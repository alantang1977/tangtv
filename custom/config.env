# ============================================
# TANG TV - 自定义配置中心
# 所有需要改的地方都在这里改，脚本会自动应用
# ============================================

# 应用名称（默认语言，英文）
APP_NAME="TANG TV"

# 应用名称 - 简体中文
APP_NAME_ZH_CN="湯影视"

# 应用名称 - 繁体中文
APP_NAME_ZH_TW="湯影視"

# 应用包名（applicationId / namespace）
PACKAGE_NAME="com.silent.android.tangtv"

# CNB 发布脚本中的仓库标识（github/scripts/sync-cnb-release.sh）
CNB_REPO_SLUG="tangtang.com.cn.kul/tangtv"

# 图标渲染风格：3d（高级立体浮雕）或 iphone17（液态玻璃发光）
ICON_STYLE="3d"

# 版本号后缀（留空表示不修改上游版本号）
# 例如：VERSION_NAME_SUFFIX="-tang" 会把 1.2.3 改成 1.2.3-tang
VERSION_NAME_SUFFIX=""

# 同步上游时是否强制覆盖 main 分支（true=强制同步，保持与上游完全一致）
FORCE_SYNC_MAIN="true"
